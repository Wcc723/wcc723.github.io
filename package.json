    "i18n:stamp": "node scripts/i18n.mjs stamp",
    "i18n:report": "node scripts/i18n.mjs report",
    "site:card": "node scripts/site-card.mjs",
    "migrate": "node scripts/migrate-hexo.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\" \"source/.vitepress/**/*.test.mjs\"",
    "images:upload": "node scripts/images-upload.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3",
    "gray-matter": "^4.0.3",
